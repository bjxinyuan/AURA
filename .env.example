# AURA 部署配置模板 (Qwen3-Omni E2E mode)
# 用法: cp .env.example .env && 编辑 .env，然后:
#   set -a; source .env; set +a; bash start_all.sh

# ===== 必填 =====
# 指向你本机的 Qwen3-Omni 模型目录 (建议 FP8 量化版)
AURA_MODEL_PATH=/path/to/your/Qwen3-Omni-30B-A3B-FP8/

# ===== 可选 (默认值如下) =====
# Flask 桥接层端口 (浏览器访问 http://host:此端口)
AURA_FLASK_PORT=5003

# 主推理服务 (Flask 桥接层连这里)
AURA_INFER_HOST=127.0.0.1
AURA_INFER_PORT=12345

# TTS 服务 (ASR 已删除：Omni 端到端处理音频)
AURA_TTS_PORT=8002

# ===== GPU 分配 (start_all.sh 已支持) =====
# 单 A800 部署：TTS 与主推理共卡
GPU_TTS=0
GPU_INFERENCE=0
